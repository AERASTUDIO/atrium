rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Atrium – uppsetning party.is (Firebase-verkefnið atrium-party). Afrit; virku reglurnar eru í Firebase Console › Firestore › Rules.
    // TIL BRÁÐABIRGÐA: innskráning með Microsoft-aðgangi AERA (@aerastudio.is, fyrsti admin dagur@aerastudio.is).
    // Þegar party.is fær eigið Microsoft 365: breyta léni í msUser() og netfangi í firstAdmin() og birta aftur.
    // Notendaskráin er í app/notendur: { notendur: { "<netfang>": { nafn, sk, hlutverk: "admin"|"bokari"|"starfsmadur", virkur } } }

    function signedIn() { return request.auth != null && request.auth.token.email != null; }
    function em() { return request.auth.token.email.lower(); }
    function provider() { return request.auth.token.firebase.sign_in_provider; }

    // Starfsmenn: Microsoft-aðgangur @aerastudio.is.
    function lenUser() { return signedIn() && provider() == "microsoft.com" && em().matches(".*@aerastudio[.]is"); }
    // 2.99.0: Microsoft-innskráning í umhverfi fyrirtækisins – starfsfólk á léni þess eða gestir (verktakar) með eigið netfang.
    // Aðgangur ræðst af notendaskránni (active()); Entra hleypir aðeins inn notendum og boðnum gestum umhverfisins.
    function msUser() { return signedIn() && provider() == "microsoft.com"; }
    // Google-varaleiðin var lögð niður 18.10.2026 (1.6.1). Aðeins Microsoft-aðgangar fyrirtækisins komast inn.
    function legacy() { return false; }
    // Fyrsti admin (fyrirtaeki.js) má stofna notendaskrána ef hún er ekki til – aðeins við nýja uppsetningu.
    function firstAdmin() { return lenUser() && em() == "dagur@aerastudio.is"; }

    function usersDoc() { return /databases/$(database)/documents/app/notendur; }
    function users() { return get(usersDoc()).data.notendur; }
    function active() { return legacy() || (msUser() && exists(usersDoc()) && em() in users() && users()[em()].virkur == true); }
    function admin() { return legacy() || (active() && users()[em()].hlutverk == "admin"); }

    // Notendaskrá: virkir notendur lesa; aðeins admin breytir.
    // Undantekning: notandi má skrá síðustu innskráningu sína (sidast) og ekkert annað.
    match /app/notendur {
      allow read: if active();
      allow create: if admin() || (firstAdmin() && !exists(usersDoc()));
      allow update: if admin() || (active()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["notendur"])
        && request.resource.data.notendur.diff(resource.data.notendur).affectedKeys().hasOnly([em()])
        && request.resource.data.notendur[em()].diff(resource.data.notendur[em()]).affectedKeys().hasOnly(["sidast"]));
      allow delete: if false;
    }

    function role() { return legacy() ? "admin" : users()[em()].hlutverk; }
    // Fjármál: admin og bókari – búa til reikninga og sjá tíma og kostnað allra.
    function fjarmal() { return active() && (legacy() || role() in ["admin", "bokari"]); }
    // Vettvangur (2.97.0): lager og vettvangur – skráir tíma, afhendir og tekur á móti pöntunum, en stofnar hvorki verkefni,
    // tilboð, pantanir né viðskiptavini, breytir ekki tilboðum eða viðskiptavinum og sér aldrei reikninga (fjarmal()).
    function vett() { return active() && role() == "vettvangur"; }
    function skrif() { return active() && !vett(); }
    // Mánuður (UTC) fyrir notkunarskráningu, t.d. "2026-10"
    function mon() { return string(request.time.year()) + "-" + (request.time.month() < 10 ? "0" : "") + string(request.time.month()); }
    function minnTegund() { return vett() ? "v" : "s"; }

    // app/state: stillingar, samtölur, netfangaskrá o.fl. (afgangurinn eftir skiptingu í söfn, frá 1.3.0).
    // Eftir flutning (skipting = 2) má ekki skrifa gömlu fylkin aftur inn – gamlar útgáfur appsins fá villu í stað þess að skrifa yfir.
    match /app/state {
      allow read: if active();
      allow write: if active() && !(resource != null && resource.data.get("skipting", 0) >= 2
        && (request.resource.data.keys().hasAny(["verkefni", "vidskiptavinir", "fundir", "skjol", "thraedir", "reikningar", "kostnadur", "klukka", "vorur", "tilbod", "pantanir"])
            || request.resource.data.get("timar", {}).keys().hasAny(["faerslur", "nyjast"])));
    }
    // Notkun (2.97.0): hver notandi skráir sig virkan í mánuðinum – aðeins eigið netfang, rétt tegund og núverandi mánuður. Admin les.
    match /app/notkun {
      allow read: if admin();
      allow create: if active() && request.resource.data.keys().hasOnly([mon()])
        && request.resource.data[mon()].keys().hasOnly([em()]) && request.resource.data[mon()][em()] == minnTegund();
      allow update: if active() && request.resource.data.diff(resource.data).affectedKeys().hasOnly([mon()])
        && request.resource.data[mon()][em()] == minnTegund()
        && (!(mon() in resource.data) ? request.resource.data[mon()].keys().hasOnly([em()])
            : request.resource.data[mon()].diff(resource.data[mon()]).affectedKeys().hasOnly([em()]));
      allow delete: if false;
    }
    match /app/skrar {
      allow read, write: if active();
    }

    // Sameiginleg söfn: allir virkir notendur lesa og skrifa.
    // Verkefnum og viðskiptavinum getur aðeins admin eytt (frá 1.9.0).
    match /verkefni/{id}       { allow read, update: if active(); allow create: if skrif(); allow delete: if admin(); }
    match /vidskiptavinir/{id} { allow read: if active(); allow create, update: if skrif(); allow delete: if admin(); }
    match /fundir/{id}         { allow read, write: if active(); }
    match /skjol/{id}          { allow read, write: if active(); }
    match /thraedir/{id}       { allow read, write: if active(); }
    // Vörulisti og tilboð (frá 2.4.0): allir virkir notendur lesa og skrifa; aðeins admin eyðir.
    match /vorur/{id}          { allow read, update: if active(); allow create: if skrif(); allow delete: if admin(); }
    match /tilbod/{id}         { allow read: if active(); allow create, update: if skrif(); allow delete: if admin(); }
    // Pantanir (frá 2.20.0): eins og tilboð. 2.98.0: vettvangur les og uppfærir aðeins pantanir sem hann er skráður á
    // (reiturinn menn = netföng starfsfólks á pöntuninni og verkefni hennar; appið heldur honum við og les með array-contains).
    function minPontun() { return !vett() || em() in resource.data.menn; }
    match /pantanir/{id}       { allow read, update: if active() && minPontun(); allow create: if skrif(); allow delete: if admin(); }

    // Reikningar: aðeins fjármál (admin, bókari) lesa og skrifa (lestur takmarkaður 2.94.2); aðeins admin eyðir (frá 1.9.0).
    match /reikningar/{id} {
      allow read: if fjarmal();
      allow create, update: if fjarmal();
      allow delete: if admin();
    }

    // Tímar og útlagður kostnaður: hver sér og skrifar sínar færslur (reiturinn eigandi = netfang); fjármál sjá og skrifa allar.
    function ownRead() { return fjarmal() || (active() && resource.data.eigandi == em()); }
    function ownWrite() { return fjarmal() || (active()
      && (resource == null || resource.data.eigandi == em())
      && (request.resource == null || request.resource.data.eigandi == em())); }
    match /timar/{id}     { allow read: if ownRead(); allow write: if ownWrite(); }
    match /kostnadur/{id} { allow read: if ownRead(); allow write: if ownWrite(); }

    // Spjall (frá 1.4.0): rásin "almennt" sjá allir virkir; bein skilaboð (ras "dm:…") aðeins aðilarnir tveir.
    // Notandi sendir aðeins í eigin nafni og getur aðeins eytt eigin skilaboðum.
    match /spjall/{id} {
      allow read: if active() && (resource.data.ras == "almennt" || em() in resource.data.adilar);
      allow create: if active() && request.resource.data.af == em()
        && (request.resource.data.ras == "almennt" || (em() in request.resource.data.adilar && request.resource.data.adilar.size() == 2));
      allow update: if false;
      allow delete: if active() && resource.data.af == em();
    }

    // Persónulegar stillingar notanda (t.d. útlit Heim-skjás), frá 1.5.0: aðeins hann sjálfur.
    match /notandi/{email} { allow read, write: if active() && email == em(); }

    // Tilkynningar (2.64.0): tæki (FCM-auðkenni) og val hvers notanda – aðeins hann sjálfur. Cloud Functions lesa með stjórnandaaðgangi.
    match /tilkynningar/{email} { allow read, write: if active() && email == em(); }

    // Tímatillögur úr Microsoft 365 (2.67.0): Cloud Functions skrifa, notandinn les aðeins sínar.
    match /tillogur/{email} { allow read: if active() && email == em(); allow write: if false; }

    // Skeiðklukka: eitt skjal á hvern notanda (netfang), aðeins hann sjálfur.
    match /klukka/{email} { allow read, write: if active() && email == em(); }

    // Pöntunarsíða viðskiptavinar (2.56.0): eitt skjal á hverja pöntun sem hefur fengið tengil. Auðkennið (t) er langur
    // tilviljunarstrengur sem aðeins sá sem fær tengilinn þekkir. Hver sem er má SÆKJA eitt skjal eftir auðkenni (ekki lista),
    // og staðfesta pöntunina EINU SINNI: aðeins reitirnir stadfest og uppfaert mega breytast og stadfest verður að vera tómt fyrir.
    // Starfsfólk (active) býr til, uppfærir og eyðir.
    match /opinber/{t} {
      allow get: if true;
      allow list: if false;
      allow create, delete: if active();
      allow update: if active() || (
        resource.data.stadfest == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stadfest", "uppfaert"])
        && request.resource.data.stadfest is map
        && request.resource.data.stadfest.nafn is string && request.resource.data.stadfest.nafn.size() > 1 && request.resource.data.stadfest.nafn.size() < 120
        && request.resource.data.stadfest.undirskrift is string && request.resource.data.stadfest.undirskrift.size() < 200000
        && (!("athugasemd" in request.resource.data.stadfest) || (request.resource.data.stadfest.athugasemd is string && request.resource.data.stadfest.athugasemd.size() < 2000)))
      // 2.72.0: viðskiptavinur hafnar tilboði (einu sinni). Spurningar af tilboðssíðunni lokaðar 2.94.2 – þær koma sem svar við póstinum
      || (resource.data.stadfest == null && resource.data.get("hafnad", null) == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hafnad", "uppfaert"])
        && request.resource.data.hafnad is map && request.resource.data.hafnad.nafn is string && request.resource.data.hafnad.nafn.size() > 1 && request.resource.data.hafnad.nafn.size() < 120
        && (!("astaeda" in request.resource.data.hafnad) || (request.resource.data.hafnad.astaeda is string && request.resource.data.hafnad.astaeda.size() < 2000)));
    }
  }
}
